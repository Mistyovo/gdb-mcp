    "name": "threads_0044",
    "source": "#include <pthread.h>\n#include <stdio.h>\n\nvolatile int ta = 0;\nvolatile int tb = 0;\n\n__attribute__((noinline)) void *worker_a(void *arg) {\n    (void)arg;\n    for (int i = 0; i < 46; i++) ta++;\n    return NULL;\n}\n\n__attribute__((noinline)) void bump(void) {\n    tb++;\n}\n\n__attribute__((noinline)) void *worker_b(void *arg) {\n    (void)arg;\n    for (int i = 0; i < 53; i++) bump();\n    return NULL;\n}\n\nint main(void) {\n    pthread_t a, b;\n    pthread_create(&a, NULL, worker_a, NULL);\n    pthread_create(&b, NULL, worker_b, NULL);\n    pthread_join(a, NULL);\n    pthread_join(b, NULL);\n    printf(\"%d %d\\n\", ta, tb);\n    return 0;\n}\n",
