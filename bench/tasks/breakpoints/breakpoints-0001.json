    "source": "#include <stdio.h>\n\nint probe = 967;\nint g_i = -1;\n\n__attribute__((noinline)) void audit(int i, int secret) {\n    printf(\"%d %d\\n\", i, secret);\n}\n\n__attribute__((noinline)) int work(void) {\n    int acc = 2090;\n    for (int i = 0; i < 16; i++) {\n        g_i = i;\n        if (i == 12) probe = 3000;\n        acc = acc * 3 + i;\n        audit(i, acc);\n    }\n    return acc;\n}\n\nint main(void) {\n    return work() % 7;\n}\n",
